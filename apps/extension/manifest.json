{
  "manifest_version": 3,
  "name": "MeetingAI Companion v1.1",
  "version": "1.0.1",
  "description": "AI companion for Google Meet",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://*.zoom.us/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.zoom.us/*"
      ],
      "js": [
        "ui/icons.js",
        "ui/siriWave.js",
        "ui/renderer.js",
        "platforms.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "ui/*"
      ],
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.zoom.us/*"
      ]
    }
  ],
  "action": {
    "default_title": "MeetingAI",
    "default_popup": "ui/popup.html"
  }
}