# ==========================================
# REQUIRED ENVIRONMENT VARIABLES
# ==========================================

# 1. Database (MongoDB)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=Truely

# 2. Security
JWT_SECRET=your_super_secret_jwt_string

# 3. AI / LLM APIs (Provide at least one)
GROQ_API_KEY_1=your_groq_api_key_1
LM_API_TOKEN=your_lm_api_token

# 4. Transcription API
DEEPGRAM_API_KEY=your_deepgram_api_key
# Lock live diarization to N people (interview default: 2). Extra Deepgram IDs remap onto these slots.
FIXED_SPEAKER_COUNT=2

# 5. Google OAuth (For Calendar Integration)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==========================================
# OPTIONAL ENVIRONMENT VARIABLES
# ==========================================

# Text-To-Speech API (Optional)
CARTESIA_API_KEY=your_cartesia_api_key

# Bot display name in meetings (Meet / Zoom / Teams guest name)
BOT_DISPLAY_NAME=Xobin

# Webhooks / public base URL (ngrok locally, or your Railway/Render URL in cloud)
WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok-free.dev
PUBLIC_URL=http://localhost:8080
API_BASE_URL=http://localhost:8080

# Meeting Test URLs (Optional, for direct API testing)
TEST_MEETING_URL=https://meet.google.com/your-meet-link

# Production Only: Redis for Queues & PubSub (Locally mocked in memory)
# UPSTASH_REDIS_URL=rediss://default:password@your-redis.upstash.io:6379

# Hosted dashboard OAuth redirect tip:
# Add PUBLIC_URL/auth/google/callback (and Microsoft/Zoom) in each provider console.
# For LAN access from another device, set PUBLIC_URL=http://YOUR_LAN_IP:8080

# HubSpot CRM (free tier is enough for contacts/companies/deals read)
# Create a HubSpot private app token OR a developer OAuth app.
# HUBSPOT_API_KEY=pat-na1-xxxxx
# HUBSPOT_CLIENT_ID=xxxxxxxx
# HUBSPOT_CLIENT_SECRET=xxxxxxxx
# HUBSPOT_REDIRECT_URI=http://localhost:8080/hubspot/callback
# HUBSPOT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
